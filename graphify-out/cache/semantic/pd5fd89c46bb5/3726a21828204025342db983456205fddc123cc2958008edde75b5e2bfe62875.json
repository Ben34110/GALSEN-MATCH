{"nodes": [{"id": "claude_skills_design_references_banner_sizes_and_styles_doc", "label": "Banner Sizes & Art Direction Styles Reference", "file_type": "document", "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_design_references_banner_sizes_and_styles_art_direction_styles", "label": "22 Art Direction Banner Styles", "file_type": "rationale", "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each of the 22 styles (Minimalist, Bold Typography, Gradient, Photo-Based, Glassmorphism, Neon/Cyberpunk, etc.) is paired with a 'best for' use-case so the right visual direction can be matched to platform/industry needs."}, {"id": "claude_skills_design_references_banner_sizes_and_styles_three_zone_rule", "label": "3-Zone Visual Hierarchy Rule", "file_type": "rationale", "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Top=logo/value prop, Middle=supporting message+visuals, Bottom=CTA \u2014 structures banner composition so the eye follows a persuasive top-to-bottom flow."}, {"id": "claude_skills_design_references_banner_sizes_and_styles_safe_zones", "label": "Banner Safe Zones Principle", "file_type": "rationale", "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Critical content must stay in the central 70-80% of canvas because platform UI chrome (e.g. Meta/Instagram overlays) and edge cropping can obscure text/CTAs placed near borders."}, {"id": "claude_skills_design_references_banner_sizes_and_styles_cta_rules", "label": "Banner CTA Rules", "file_type": "rationale", "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One CTA, high contrast, bottom-right placement, 44px minimum height \u2014 maximizes tap/click success and avoids diluting the call to action with competing choices."}, {"id": "claude_skills_design_references_banner_sizes_and_styles_print_specs", "label": "Banner Print Specs", "file_type": "concept", "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_design_references_banner_sizes_and_styles_doc", "target": "claude_skills_design_references_banner_sizes_and_styles_art_direction_styles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_design_references_banner_sizes_and_styles_doc", "target": "claude_skills_design_references_banner_sizes_and_styles_three_zone_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_design_references_banner_sizes_and_styles_doc", "target": "claude_skills_design_references_banner_sizes_and_styles_safe_zones", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/design/references/banner-sizes-and-styles.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_design_references_banner_sizes_and_styles_doc", "target": "claude_skills_design_references_banner_sizes_and_styles_cta_rules", "relation": "r