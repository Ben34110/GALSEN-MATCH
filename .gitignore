# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# api-football sync cache (raw API dumps, regenerate via scripts/sync-african-players.mjs)
.cache/

# iOS (Capacitor) — the ios/ Xcode project itself IS committed (it's
# hand-configured: bundle id, signing team, display name), only per-machine
# build/user state is ignored. See docs/ios-app.md.
ios/App/App/public/
ios/App/Pods/
ios/App/build/
ios/DerivedData/
ios/**/*.xcuserdatad/
ios/**/xcuserdata/
ios/**/.DS_Store
